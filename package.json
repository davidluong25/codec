{
  "name": "1code-monorepo",
  "version": "0.0.58",
  "private": true,
  "description": "1Code - UI for parallel work with AI agents",
  "author": {
    "name": "21st.dev",
    "email": "support@21st.dev"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "dev:frontend": "turbo run dev --filter=@1code/frontend",
    "dev:backend": "turbo run dev --filter=@1code/backend",
    "build:frontend": "turbo run build --filter=@1code/frontend",
    "build:backend": "turbo run build --filter=@1code/backend",
    "db:generate": "cd apps/backend && drizzle-kit generate",
    "db:push": "cd apps/backend && drizzle-kit push",
    "db:studio": "cd apps/backend && drizzle-kit studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.4.5"
  }
}
